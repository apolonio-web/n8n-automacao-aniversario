    {
      "parameters": {
        "jsCode": "// Resgata o nome e o telefone diretamente do nó da planilha\nconst nome = $('Listar Usuários').first().json.NOME;\nconst telefone = $('Listar Usuários').first().json.TELEFONE;\n\nconst instrucao = `Gere uma mensagem curta e especial de FELIZ ANIVERSÁRIO para envio por WhatsApp para ${nome}.\n\nREGRAS RÍGIDAS DE FORMATO:\n- Gere APENAS o texto final da mensagem.\n- NÃO adicione títulos, \"Assunto:\", aspas ou marcadores.\n- O tom deve ser alegre, caloroso, festivo e amigável.\n- Mencione o nome ${nome} de forma natural.\n- Inclua alguns emojis de celebração (ex: 🎂, 🎉, 🥳).\n- A mensagem deve ter no máximo 3 ou 4 linhas.`;\n\nreturn {\n  json: {\n    prompt: instrucao,\n    TELEFONE: telefone\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
